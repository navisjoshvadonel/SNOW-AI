# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ANTHROPIC_API_KEY: Required for Claude models
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# SERVER & NETWORK SECURITY CONFIGURATION
HOST="127.0.0.1"
PORT="3000"

# PERMISSION GATING MODE: "default" (guarded / safe), "acceptEdits" (auto-approves edits), or "bypassPermissions"
SNOW_PERMISSION_MODE="default"

# OPTIONAL API AUTHENTICATION TOKEN: If set, all /api/snow/* endpoints require Bearer <token> or x-api-key
# SNOW_API_KEY="your-secure-token-here"

# ACCESS CONTROL & AUTHENTICATION CONFIGURATION
# SNOW_AUTH_PASSWORD: Password / Master PIN to unlock Snow AI (default: "2026").
SNOW_AUTH_PASSWORD="2026"

# SNOW_AUTH_SECRET: JWT signing secret for session tokens.
# If unset, a random secret is generated at startup (all sessions invalidated on server restart).
# Set this to a stable secret if you want sessions to survive restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SNOW_AUTH_SECRET="your-64-char-hex-secret-here"

# SNOW_AUTH_USER: Authorized user display name (default: $USER or "snowjd")
SNOW_AUTH_USER="snowjd"
