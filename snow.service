[Unit]
Description=SNOW AI Personal Operating System Assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/snowjd/Documents/Snow Jarvis
ExecStart=/usr/bin/node "/home/snowjd/Documents/Snow Jarvis/node_modules/.bin/tsx" "/home/snowjd/Documents/Snow Jarvis/server.ts"
Restart=on-failure
RestartSec=3s
Environment=PORT=3000
Environment=NODE_ENV=production
Environment=OLLAMA_MODELS=/usr/share/ollama/.ollama/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_KEEP_ALIVE=24h
Environment=OLLAMA_IGPU_ENABLE=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=USE_LOCAL_FAST_PATH=true
Environment=OFFLINE_PRIMARY=true
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin:/home/snowjd/.local/bin:/home/snowjd/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
